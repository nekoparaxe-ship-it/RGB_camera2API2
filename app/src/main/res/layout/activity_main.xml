<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/texture_view"
        app:layout_constraintEnd_toEndOf="@id/texture_view"
        app:layout_constraintStart_toStartOf="@id/texture_view"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/gain_buttons_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/no_gain_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="无增益\nNo Gain"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:strokeColor="@android:color/darker_gray" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reset_gain_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="重置增益\nReset"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:strokeColor="@android:color/darker_gray" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rgb_gain_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <EditText
                android:id="@+id/red_gain_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="R Gain (1.0)"
                android:inputType="numberDecimal"
                android:textColor="@android:color/white"
                android:textColorHint="#CCCCCC"
                android:backgroundTint="@android:color/holo_red_dark"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/green_gain_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="G Gain (3.0)"
                android:inputType="numberDecimal"
                android:textColor="@android:color/white"
                android:textColorHint="#CCCCCC"
                android:backgroundTint="@android:color/holo_green_dark"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/blue_gain_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="B Gain (18.0)"
                android:inputType="numberDecimal"
                android:textColor="@android:color/white"
                android:textColorHint="#CCCCCC"
                android:backgroundTint="@android:color/holo_blue_dark"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextureView
        android:id="@+id/texture_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="11:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.9" />

    <TextView
        android:id="@+id/countdown_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="96sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:background="#80000000"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="@id/texture_view"
        app:layout_constraintBottom_toBottomOf="@id/texture_view"
        app:layout_constraintStart_toStartOf="@id/texture_view"
        app:layout_constraintEnd_toEndOf="@id/texture_view"
        tools:text="2"
        tools:visibility="visible"/>


    <TextView
        android:id="@+id/instruction_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#80000000"
        android:gravity="center"
        android:padding="8dp"
        android:text="在开始录制前请将手指贴紧镜头与闪光灯\nPlace finger close to lens &amp; flash before recording\n闪光灯开启后将强制使用自动ISO\nAuto ISO will be forced when flash is on"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/timer_text"
        app:layout_constraintEnd_toEndOf="@id/texture_view"
        app:layout_constraintStart_toStartOf="@id/texture_view" />

    <TextView
        android:id="@+id/timer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#80000000"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        android:text="00:00"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/record_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/record_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="录制\nRecord"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@android:color/white" />

    <!-- 新增：手册按钮 -->
    <ImageButton
        android:id="@+id/manual_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="使用手册 / Manual"
        android:src="@android:drawable/ic_menu_help"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>

